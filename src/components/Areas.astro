---
// Las seis areas de trabajo declaradas en el PIF 2026 de la asociacion, en el
// mismo orden. Cada una lleva icono propio: son seis bloques con estructura
// identica y sin icono la rejilla se lee como un muro de texto. Los iconos son
// SVG inline y decorativos (el titulo ya nombra el area), asi que no aportan
// texto alternativo.
const ICON =
  'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const areas = [
  {
    titulo: 'Diálogo intercultural y cohesión comunitaria',
    texto:
      'Foros y mesas redondas que fomentan el entendimiento mutuo y la convivencia ' +
      'respetuosa entre jóvenes de distintos orígenes culturales. Métodos dialógicos y ' +
      'vivenciales para trabajar la competencia intercultural, la prevención de ' +
      'conflictos y el sentido de pertenencia, con la diversidad de Melilla entendida ' +
      'como fortaleza.',
    icono:
      '<path d="M13.5 3.5H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h1.4V17l3.7-3.5h3.4a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2Z"/><path d="M17.6 8.5H19a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-1v3l-3.2-3H11"/>',
  },
  {
    titulo: 'Pensamiento crítico y alfabetización mediática',
    texto:
      'Talleres y sesiones interactivas de pensamiento crítico, argumentación y ' +
      'verificación de datos. Ayudan a reconocer la desinformación, a reflexionar sobre ' +
      'el contenido en línea y a debatir con respeto, con estudios de caso, juegos de rol ' +
      'y debates guiados. Incluye la lucha contra el discurso de odio.',
    icono:
      '<circle cx="11" cy="11" r="6.5"/><path d="M20.5 20.5 15.7 15.7"/><path d="M8.6 11.1l1.9 1.9 3.9-4"/>',
  },
  {
    titulo: 'Derechos humanos e igualdad',
    texto:
      'Charlas, talleres temáticos y encuentros de diálogo sobre los valores europeos ' +
      'fundamentales: derechos humanos, solidaridad, igualdad y cultura democrática. Se ' +
      'conectan con la vida diaria de las personas jóvenes mediante métodos ' +
      'participativos.',
    icono:
      '<path d="M12 3.5v17"/><path d="M7.5 20.5h9"/><path d="M4.5 7.4 12 5.4l7.5 2"/><path d="M4.5 7.4 2 13.4h5Z"/><path d="M19.5 7.4 17 13.4h5Z"/>',
  },
  {
    titulo: 'Inclusión de jóvenes con discapacidad',
    texto:
      'Accesibilidad y prácticas inclusivas integradas en la actividad ordinaria, ' +
      'adaptando metodologías y formatos. Talleres y mesas redondas de sensibilización ' +
      'que promueven la empatía, reducen el estigma y animan a cocrear iniciativas ' +
      'inclusivas.',
    icono:
      '<circle cx="12" cy="4" r="1.9"/><path d="M12 7.6v4.6h4"/><path d="M16 12.2l2 5.6"/><circle cx="11" cy="16.4" r="4.9"/>',
  },
  {
    titulo: 'Participación juvenil y compromiso cívico',
    texto:
      'Actividades para entender la participación democrática y desarrollar la capacidad ' +
      'de intervenir en los espacios de decisión. Foros juveniles y mesas de debate que ' +
      'trabajan el liderazgo, la oratoria, la organización comunitaria y el diálogo ' +
      'estructurado, a nivel local y europeo.',
    icono:
      '<path d="M4 10.5h16v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19.5Z"/><path d="M9 10.5V4.5h6v6"/><path d="M9.8 15h4.4"/>',
  },
  {
    titulo: 'Medioambiente y sostenibilidad',
    texto:
      'Talleres prácticos y charlas públicas sobre conciencia ambiental, consumo ' +
      'responsable y acción climática cotidiana. En foros y mesas redondas los jóvenes ' +
      'debaten los retos ambientales locales y proponen soluciones.',
    icono:
      '<path d="M11 20.5C6.3 20.5 3.5 17.2 3.5 12.7 3.5 7 8.2 3.5 20.5 3.5c0 11-4.8 17-9.5 17Z"/><path d="M8 19c2.6-6 6-9.6 10.4-12"/>',
  },
];
---

<section class="areas section section-cal" aria-labelledby="areas-titulo">
  <div class="container">
    <div class="areas-cabecera fade-in">
      <p class="section-label">Áreas de trabajo</p>
      <div class="divider"></div>
      <h2 id="areas-titulo" class="section-title">Seis frentes, un mismo método</h2>
      <p class="section-subtitle">
        Educación no formal: se aprende haciendo, debatiendo y decidiendo en grupo. Estas
        son las líneas en las que la asociación trabaja con la juventud de Melilla.
      </p>
    </div>

    <ul class="areas-lista grid-3 fade-in fade-in-delay-1">
      {areas.map((area) => (
        <li class="area card-plana">
          <span class="area-icono" aria-hidden="true">
            <Fragment set:html={`<svg ${ICON} width="24" height="24">${area.icono}</svg>`} />
          </span>
          <h3>{area.titulo}</h3>
          <p>{area.texto}</p>
        </li>
      ))}
    </ul>

    <p class="areas-mas fade-in fade-in-delay-2">
      <a href={`${base}/que-hacemos/`} class="btn btn-outline">Ver qué hacemos en detalle</a>
    </p>
  </div>
</section>

<style>
  .areas-cabecera {
    margin-bottom: 2.5rem;
  }

  .area {
    padding: 1.75rem 1.6rem;
  }
  .area-icono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.85rem;
    height: 2.85rem;
    margin-bottom: 1rem;
    border-radius: var(--radius-md);
    background: var(--terracota-dim);
    color: var(--terracota-texto);
  }
  .area h3 {
    font-size: 1.14rem;
    line-height: 1.3;
    color: var(--indigo);
    margin-bottom: 0.6rem;
  }
  .area p {
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--tinta-suave);
  }

  .areas-mas {
    margin-top: 2.5rem;
  }
</style>
